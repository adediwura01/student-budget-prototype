# Local configuration only. Use your existing PostgreSQL role and credentials.
APP_ENV=development
FLASK_APP=app
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# Generate a random value locally; never use this placeholder as a secret.
SECRET_KEY=replace-with-a-generated-secret-of-at-least-32-characters

# URL-encode special characters in credentials. These are harmless placeholders.
DEV_DATABASE_URL=postgresql+psycopg://your_role:your_password@127.0.0.1:5432/finset_dev
TEST_DATABASE_URL=postgresql+psycopg://your_role:your_password@127.0.0.1:5432/finset_test

# Only a configuration flag exists at this stage; no email is sent.
EMAIL_MODE=fake

# Production must supply SECRET_KEY and DATABASE_URL in the process environment.
# Set FLASK_SKIP_DOTENV=1 in production; do not deploy with local .env settings.
# DATABASE_URL=postgresql+psycopg://your_role:your_password@your_host:5432/finset_prod
